{
  "name": "paypilot",
  "version": "0.1.0",
  "private": true,
  "description": "Payments dashboard with a tool-calling AI copilot (mock-first, Gemini optional). Portfolio MVP.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.106",
    "@ai-sdk/provider": "^2.0.5",
    "@ai-sdk/react": "^2.0.285",
    "@tanstack/react-query": "^5.105.0",
    "ai": "^5.0.282",
    "clsx": "^2.1.1",
    "next": "^15.5.28",
    "react": "~19.1.10",
    "react-dom": "~19.1.10",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.55.1",
    "@storybook/react-vite": "^9.1.21",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "storybook": "^9.1.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
