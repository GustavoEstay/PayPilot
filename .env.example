# PayPilot runs fully offline by default with a deterministic MOCK copilot provider.
# Nothing here is required.

# Optional: enable the real Gemini provider (free tier key from https://aistudio.google.com/apikey).
# Server-side only, never exposed to the browser (no NEXT_PUBLIC_ prefix).
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: Gemini model id (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: force a provider regardless of the key ("mock" | "gemini"). E2E tests force "mock".
COPILOT_PROVIDER=

# Optional: copilot rate limit (requests per minute per client, default 20)
COPILOT_RATE_LIMIT_PER_MINUTE=20
